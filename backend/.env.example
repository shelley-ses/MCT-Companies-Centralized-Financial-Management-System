PROJECT_NAME="MCT Companies Centralized Financial Management System"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174"]
HOST="127.0.0.1"
PORT=8000

# Supabase API Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase PostgreSQL Direct Database Connection (Optional for SQLAlchemy ORM)
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres"

# Resend settings for login OTP email
RESEND_API_KEY="re_your-api-key"
RESEND_FROM_EMAIL="MCT Financial Management <no-reply@your-verified-domain.com>"
OTP_COOKIE_SECURE=false
